# Copy this file to .env (same folder) and fill in your key.
# .env is git-ignored, so your key never gets committed.
#
# Used by the "Sync stats" button. Each sync is a billed API call with
# web search — check with the API key holder before using it.
ANTHROPIC_API_KEY=

# Only needed if your API key is organization-wide rather than scoped to one
# workspace (Anthropic will say "API key is not scoped to a workspace").
# Find the ID in the Anthropic Console under Settings → Workspaces.
ANTHROPIC_WORKSPACE_ID=

# Instagram — filled in for you by `npm run ig:setup` (see README).
# Lets Sync read exact Instagram followers, posts and likes + comments
# through Strandberg's own Instagram professional account. Token lasts 60 days.
META_ACCESS_TOKEN=
IG_USER_ID=
META_TOKEN_EXPIRES=
